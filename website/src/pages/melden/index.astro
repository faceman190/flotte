---
// Meldeformular: Fehler, Verbesserungsvorschläge, Sonstiges. Schickt an /api/meldung (Node-Server, server/meldungen.mjs).
// Vorbelegen per Adresse: /melden/?art=vorschlag&bereich=website
import Base from '../../layouts/Base.astro';
import { ARTEN, BEREICHE, spielVersion } from '../../lib/meldung';
import { SPIEL_URL } from '../../lib/spiel';

const version = spielVersion();
---
<Base title="Fehler melden" aktiv="melden" description="Fehler gefunden oder eine Idee für Letzte Crew? Hier meldest du Fehler und Verbesserungsvorschläge direkt an die Werft.">
  <section class="m-kopf">
    <div class="wrap">
      <div class="tag">Funkkanal zur Werft</div>
      <h1>Fehler melden</h1>
      <p class="lead">Letzte Crew ist in der Alpha und ändert sich fast jeden Tag. Wenn etwas hakt oder dir etwas fehlt, schreib es hier auf.
        Jede Meldung landet direkt bei der Werft und wird gelesen.</p>
    </div>
  </section>

  <section class="wrap m-grid">
    <form id="meldung" class="m-form" novalidate data-version={version}>
      <!-- 01 Art -->
      <fieldset class="schritt">
        <legend><span class="nr">01</span>Worum geht es?</legend>
        <div class="arten">
          {ARTEN.map((a, i) => (
            <label class={`art art-${a.k}`}>
              <input type="radio" name="art" value={a.k} checked={i === 0} />
              <span class="art-ico" aria-hidden="true">
                {a.k === 'fehler' && <svg viewBox="0 0 24 24"><path d="M12 3 2 21h20L12 3Z" /><path d="M12 10v5M12 17.6v.4" /></svg>}
                {a.k === 'vorschlag' && <svg viewBox="0 0 24 24"><path d="M12 3v3M4.2 6.2l2.1 2.1M19.8 6.2l-2.1 2.1M9 18h6M10 21h4" /><path d="M8.5 15c-1.3-1.1-2-2.6-2-4.2a5.5 5.5 0 0 1 11 0c0 1.6-.7 3.1-2 4.2" /></svg>}
                {a.k === 'sonstiges' && <svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4V5Z" /><path d="M8 9.5h8M8 12.5h5" /></svg>}
              </span>
              <span class="art-t">{a.t}</span>
              <span class="art-e">{a.e}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- 02 Bereich -->
      <fieldset class="schritt">
        <legend><span class="nr">02</span>Wo im Spiel?</legend>
        <div class="chips">
          {BEREICHE.map((b) => (
            <label class="chip"><input type="radio" name="bereich" value={b.k} checked={b.k === 'sonstiges'} /><span>{b.t}</span></label>
          ))}
        </div>
      </fieldset>

      <!-- 03 Beschreibung -->
      <fieldset class="schritt">
        <legend><span class="nr">03</span>Was ist los?</legend>
        <label class="feld">
          <span class="f-t">Kurzer Titel <i class="zaehler" data-fuer="titel">0 / 120</i></span>
          <input name="titel" maxlength="120" required autocomplete="off" data-ph-fehler="z. B. Laser feuert nach dem Andocken nicht mehr" data-ph-vorschlag="z. B. Frachtraum im Markt-Terminal sortieren" data-ph-sonstiges="Worum geht es?" />
        </label>
        <label class="feld">
          <span class="f-t" data-t-fehler="Was ist passiert?" data-t-vorschlag="Was schlägst du vor?" data-t-sonstiges="Deine Nachricht">Was ist passiert?</span>
          <textarea name="text" rows="6" maxlength="6000" required data-ph-fehler="Beschreibe, was du gesehen hast. Wo warst du, mit welchem Schiff, was hast du gerade gemacht?" data-ph-vorschlag="Was soll anders werden, und warum würde es das Spiel besser machen?" data-ph-sonstiges="Schreib einfach los."></textarea>
          <i class="zaehler unten" data-fuer="text">0 / 6000</i>
        </label>
        <div class="nur-fehler">
          <label class="feld">
            <span class="f-t">Wie kommt man dahin? <em>optional</em></span>
            <textarea name="schritte" rows="4" maxlength="3000" placeholder={'1. An der Bastion abgedockt\n2. Ins Metallfeld geflogen\n3. Laser gewählt (Taste 2) …'}></textarea>
          </label>
          <label class="feld">
            <span class="f-t">Was hättest du erwartet? <em>optional</em></span>
            <input name="erwartet" maxlength="2000" autocomplete="off" placeholder="z. B. dass der Laser wieder feuert" />
          </label>
        </div>
      </fieldset>

      <!-- 04 Bild -->
      <fieldset class="schritt">
        <legend><span class="nr">04</span>Bildschirmfoto <em>optional</em></legend>
        <div class="ablage" id="ablage" tabindex="0" role="button" aria-label="Bildschirmfoto auswählen">
          <input type="file" id="bild" accept="image/*" hidden />
          <div class="ablage-leer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h4l2-3h6l2 3h4v13H3V7Z" /><circle cx="12" cy="13" r="3.6" /></svg>
            <p><strong>Bild hierher ziehen</strong>, auswählen oder mit <kbd>Strg</kbd>+<kbd>V</kbd> einfügen</p>
            <p class="klein">Ein Bild sagt oft mehr als drei Absätze. Es wird vor dem Senden verkleinert.</p>
          </div>
          <div class="ablage-voll" hidden>
            <img id="bild-vorschau" alt="Vorschau des Bildschirmfotos" />
            <div class="ablage-info"><span class="mono" id="bild-info"></span><button type="button" class="weg" id="bild-weg">Entfernen</button></div>
          </div>
        </div>
      </fieldset>

      <!-- 05 Absender -->
      <fieldset class="schritt">
        <legend><span class="nr">05</span>Absender <em>optional</em></legend>
        <div class="zwei">
          <label class="feld">
            <span class="f-t">Pilotenname</span>
            <input name="pilot" maxlength="32" autocomplete="nickname" placeholder="Name im Spiel" />
          </label>
          <label class="feld">
            <span class="f-t">Kontakt für Rückfragen</span>
            <input name="kontakt" maxlength="120" autocomplete="off" placeholder="E-Mail oder Discord-Name" />
          </label>
        </div>
        <label class="haken">
          <input type="checkbox" name="technik" checked />
          <span>Technische Angaben mitschicken</span>
        </label>
        <dl class="technik mono" id="technik">
          <dt>Spielversion</dt><dd id="t-version">{version || '–'}</dd>
          <dt>Browser</dt><dd id="t-browser">–</dd>
          <dt>System</dt><dd id="t-system">–</dd>
          <dt>Bildschirm</dt><dd id="t-bild">–</dd>
        </dl>
      </fieldset>

      <!-- Lockfeld für Bots: Menschen sehen es nicht -->
      <label class="lock" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>

      <div class="senden">
        <button class="btn big" type="submit" id="senden">Meldung absenden <span class="pfeil">›</span></button>
        <p class="hinweis" id="hinweis" role="status" aria-live="polite"></p>
        <p class="kurz-ds">Gespeichert wird nur, was du hier einträgst (und auf Wunsch die technischen Angaben). Keine IP-Adresse, Name und Kontakt sind freiwillig.</p>
      </div>
    </form>

    <div class="m-fertig tafel" id="fertig" hidden tabindex="-1">
      <div class="tag data">Übertragung bestätigt</div>
      <h2>Meldung <span class="mono" id="fertig-nr">#0</span> ist eingegangen</h2>
      <p>Danke, Pilot. Die Werft liest jede Meldung. Hast du einen Kontakt angegeben, melden wir uns bei Rückfragen.</p>
      <div class="knoepfe">
        <button class="btn" type="button" id="noch-eine">Weitere Meldung</button>
        <a class="btn ghost" href={SPIEL_URL}>Zurück ins Spiel <span class="pfeil">›</span></a>
      </div>
    </div>

    <aside class="m-seite">
      <div class="tafel tipp">
        <div class="tag data">So hilft deine Meldung am meisten</div>
        <ol>
          <li><strong>Ein Problem je Meldung.</strong> Zwei Fehler, zwei Meldungen.</li>
          <li><strong>Was hast du gerade gemacht?</strong> Sektor, Station, Schiff und die letzten Handgriffe.</li>
          <li><strong>Passiert es wieder?</strong> Wenn ja, schreib die Schritte auf.</li>
          <li><strong>Ruckeln oder wenig Bilder pro Sekunde?</strong> Drück im Spiel <kbd>F3</kbd> und schreib die Zeile mit der Grafikkarte ab, oder mach ein Foto davon.</li>
        </ol>
      </div>
      <div class="tafel tipp">
        <div class="tag data">Was gespeichert wird</div>
        <p>Deine Angaben aus dem Formular und, wenn du den Haken setzt, Spielversion, Browser und Bildschirmgröße. Keine IP-Adresse, kein
          Konto. Name und Kontakt sind freiwillig und dienen nur Rückfragen zu deiner Meldung.</p>
      </div>
    </aside>
  </section>
</Base>

<script>
  import { starteMelden } from '../../scripts/melden';
  starteMelden();
</script>

<style>
  .m-kopf { border-bottom: 1px solid var(--line); background: linear-gradient(180deg, var(--bg2), var(--bg)); }
  .m-kopf .wrap { padding-top: clamp(48px, 8vw, 104px); padding-bottom: clamp(32px, 5vw, 56px); }
  h1 { font-size: clamp(44px, 7vw, 88px); text-transform: uppercase; margin: 10px 0 16px; line-height: .92; }
  .lead { max-width: 640px; color: #c9d4de; font-size: 18px; margin: 0; }

  .m-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 28px 56px; align-items: start; padding-top: clamp(32px, 5vw, 56px); padding-bottom: clamp(56px, 8vw, 104px); }
  .m-seite { display: flex; flex-direction: column; gap: 20px; position: sticky; top: 88px; }
  .tipp { padding: 22px 24px; font-size: 15px; color: var(--mut); }
  .tipp .tag { margin-bottom: 12px; }
  .tipp ol { margin: 0; padding-left: 1.2em; display: grid; gap: 10px; }
  .tipp li::marker { color: var(--acc); font-family: var(--mono); }
  .tipp strong { color: var(--txt); font-weight: 500; }
  .tipp p { margin: 0; }
  kbd { font: 400 12.5px/1 var(--mono); color: var(--txt); border: 1px solid var(--line2); background: var(--panel2); padding: 3px 6px 2px; white-space: nowrap; }

  .schritt { border: 0; margin: 0 0 40px; padding: 0; min-width: 0; }
  legend { display: flex; align-items: baseline; gap: 14px; padding: 0; margin-bottom: 18px; font: 600 26px/1.1 var(--head); letter-spacing: .05em; text-transform: uppercase; }
  legend em, .f-t em { font: 400 12px var(--mono); letter-spacing: .12em; color: var(--dim); font-style: normal; text-transform: uppercase; }
  .nr { font: 400 13px var(--mono); color: var(--acc); letter-spacing: .1em; padding: 4px 7px 3px; border: 1px solid rgba(255, 154, 46, .45); transform: translateY(-3px); }

  /* Art: drei Kacheln */
  .arten { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .art { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto 1fr; align-items: center; gap: 12px 12px; padding: 16px 18px; background: var(--panel); border: 1px solid var(--line); cursor: pointer; transition: border-color .15s, background .15s; }
  .art:hover { border-color: var(--line2); }
  .art input { position: absolute; opacity: 0; pointer-events: none; }
  .art-ico { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--line2); color: var(--mut); }
  .art-ico svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .art-t { font: 600 20px/1.1 var(--head); letter-spacing: .05em; overflow-wrap: anywhere; text-transform: uppercase; }
  .art-e { grid-column: 1 / -1; align-self: start; color: var(--mut); font-size: 14px; line-height: 1.45; }
  .art:has(input:checked) { border-color: var(--acc); background: linear-gradient(135deg, rgba(255, 154, 46, .1), transparent 70%), var(--panel); }
  .art:has(input:checked) .art-ico { color: var(--acc); border-color: var(--acc); }
  .art:has(input:focus-visible) { outline: 2px solid var(--data); outline-offset: 3px; }

  /* Bereich: Auswahlplaketten */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span { display: inline-block; padding: 9px 14px 8px; font: 500 15px/1 var(--head); letter-spacing: .1em; text-transform: uppercase; color: var(--mut); background: var(--panel); border: 1px solid var(--line); cursor: pointer; transition: color .15s, border-color .15s, background .15s;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px); }
  .chip span:hover { color: var(--txt); border-color: var(--line2); }
  .chip input:checked + span { color: #140b02; background: var(--acc); border-color: var(--acc); }
  .chip input:focus-visible + span { outline: 2px solid var(--data); outline-offset: 2px; }

  /* Eingabefelder */
  .feld { position: relative; display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; }
  .f-t { display: flex; align-items: baseline; gap: 10px; font: 400 12.5px var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--mut); }
  .zaehler { margin-left: auto; font: 400 12px var(--mono); color: var(--dim); font-style: normal; letter-spacing: .05em; }
  .zaehler.unten { position: absolute; right: 10px; bottom: 8px; pointer-events: none; }
  input:not([type]), textarea { width: 100%; background: var(--bg2); color: var(--txt); border: 1px solid var(--line2); border-radius: 0; padding: 12px 14px; font: 400 16px/1.5 var(--body); transition: border-color .15s, background .15s; }
  textarea { resize: vertical; min-height: 96px; padding-bottom: 28px; }
  input:not([type]):focus, textarea:focus { outline: none; border-color: var(--data); background: #060b11; }
  input::placeholder, textarea::placeholder { color: var(--dim); }
  .feld.falsch input, .feld.falsch textarea { border-color: var(--bad); }
  .zwei { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
  .m-form:not([data-art="fehler"]) .nur-fehler { display: none; }

  /* Bildablage */
  .ablage { border: 1px dashed var(--line2); background: var(--bg2); cursor: pointer; transition: border-color .15s, background .15s; }
  .ablage:hover, .ablage.drueber { border-color: var(--data); background: rgba(124, 196, 255, .05); }
  .ablage-leer { padding: 28px 20px; text-align: center; color: var(--mut); }
  .ablage-leer svg { width: 34px; height: 34px; fill: none; stroke: var(--data); stroke-width: 1.4; stroke-linejoin: round; margin: 0 auto 10px; display: block; }
  .ablage-leer p { margin: 0; }
  .ablage-leer strong { color: var(--txt); font-weight: 500; }
  .ablage-leer .klein { font-size: 14px; color: var(--dim); margin-top: 6px; }
  .ablage-voll { padding: 12px; cursor: default; }
  .ablage-voll img { max-height: 280px; width: auto; margin: 0 auto; border: 1px solid var(--line); }
  .ablage-info { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 10px; font-size: 13px; color: var(--mut); }
  .weg { background: none; border: 1px solid var(--line2); color: var(--txt); font: 500 14px var(--head); letter-spacing: .12em; text-transform: uppercase; padding: 7px 12px; cursor: pointer; }
  .weg:hover { border-color: var(--bad); color: var(--bad); }

  .haken { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; color: var(--txt); font-size: 15px; margin: 4px 0 12px; }
  .haken input { width: 18px; height: 18px; accent-color: var(--acc); margin: 0; }
  .technik { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; margin: 0; padding: 14px 16px; border-left: 2px solid var(--line2); background: var(--panel); font-size: 13px; transition: opacity .15s; }
  .technik dt { color: var(--dim); letter-spacing: .1em; text-transform: uppercase; }
  .technik dd { margin: 0; color: var(--data); overflow-wrap: anywhere; }
  .technik.aus { opacity: .35; }

  .lock { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .senden { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; padding-top: 24px; border-top: 1px solid var(--line); }
  .senden .btn[disabled] { opacity: .6; cursor: wait; }
  .hinweis { margin: 0; font-size: 15px; color: var(--mut); }
  .hinweis.fehler { color: var(--bad); }
  .kurz-ds { display: none; flex-basis: 100%; margin: 0; font-size: 13.5px; color: var(--dim); }

  .m-fertig { padding: clamp(28px, 4vw, 44px); }
  .m-fertig:focus { outline: none; }
  .m-fertig h2 { font-size: clamp(32px, 4.4vw, 50px); text-transform: uppercase; margin: 12px 0 14px; }
  .m-fertig h2 .mono { color: var(--acc); font-size: .8em; letter-spacing: .02em; }
  .m-fertig p { color: var(--mut); max-width: 56ch; }
  .knoepfe { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  @media (max-width: 1000px) {
    .m-grid { grid-template-columns: minmax(0, 1fr); }
    .m-seite { position: static; order: -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .arten { grid-template-columns: minmax(0, 1fr); }
    .m-seite { grid-template-columns: minmax(0, 1fr); }
    .m-seite .tipp:last-child { display: none; }
    .kurz-ds { display: block; }
    .zwei { grid-template-columns: minmax(0, 1fr); }
    .senden .btn { width: 100%; }
  }
</style>
