---
import Base from '../layouts/Base.astro';
import { SCHIFFE, ENV_URL, credits, SPIEL_URL } from '../lib/spiel';
import { WERTE, GRUPPEN, fmtWert } from '../lib/werte';

const max: Record<string, number> = {};
for (const w of WERTE) max[w.k] = Math.max(...SCHIFFE.map((s) => s.werte[w.k]));
const daten = { schiffe: SCHIFFE, env: ENV_URL };
const erstes = SCHIFFE[0];
const gruppen = Object.entries(GRUPPEN) as [keyof typeof GRUPPEN, string][];
const lang = (v: number) => String(v).replace('.', ',');
---
<Base title="Schiffe" aktiv="schiffe" description="Alle Schiffe von Letzte Crew in 3D: drehen, vergleichen, Werte ansehen – vom leichten Jäger Milan bis zum Langstreckenkreuzer Pfeil.">
  <section class="wrap kopfzeile">
    <div class="tag">Schiffs-Explorer</div>
    <h1>Die Flotte</h1>
    <p class="muted">Dieselben Modelle und Grundwerte wie im Spiel, ohne Ausbauten. Ziehen zum Drehen, Mausrad oder zwei Finger zum Zoomen.</p>
  </section>

  <section class="wrap explorer" id="explorer">
    <nav class="wahl" aria-label="Schiff wählen">
      {SCHIFFE.map((s, i) => (
        <button type="button" class:list={['w-btn', { an: i === 0 }]} data-id={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <i style={`background:${s.col}`}></i>
          <b>{s.n}</b>
          <span>{s.role}</span>
        </button>
      ))}
    </nav>

    <div class="buehne tafel">
      <canvas id="ansicht" aria-label="3D-Ansicht des gewählten Schiffs"></canvas>
      <div class="lade" id="lade"><span class="mono" id="lade-t">Lade Modell …</span><div class="balken"><i id="lade-b"></i></div></div>
      <div class="b-oben mono">
        <span id="b-name">{erstes.n}</span>
        <span id="b-len">Länge {lang(erstes.len)} m</span>
      </div>
      <div class="b-unten">
        <label class="schalter"><input type="checkbox" id="opt-dreh" checked> <span>Drehen</span></label>
        <label class="schalter"><input type="checkbox" id="opt-gear"> <span>Fahrwerk</span></label>
        <button type="button" class="schalter" id="opt-reset">Ansicht zurücksetzen</button>
      </div>
      <p class="kein-3d mono" id="kein-3d" hidden>3D-Ansicht nicht verfügbar (WebGL ist im Browser ausgeschaltet).</p>
    </div>

    <aside class="info tafel" id="info">
      <div class="i-kopf">
        <div>
          <span class="tag" id="i-rolle">{erstes.role}</span>
          <h2 id="i-name">{erstes.n}</h2>
        </div>
        <div class="i-preis">
          <span class="lbl">Werft</span>
          <b class="mono" id="i-preis">{credits(erstes)}</b>
        </div>
      </div>
      <p id="i-desc">{erstes.desc}</p>
      <div class="i-merk mono" id="i-merk">
        <span>{lang(erstes.len)} m</span><span>{erstes.innen ? 'Innen begehbar' : 'Einsitzig, kein Innenraum'}</span>
      </div>

      <div class="vergleich">
        <label for="vgl">Vergleichen mit</label>
        <select id="vgl">
          <option value="">–</option>
          {SCHIFFE.map((s) => <option value={s.id}>{s.n} · {s.role}</option>)}
        </select>
      </div>

      <div class="werte" id="werte">
        {gruppen.map(([g, titel]) => (
          <div class="w-gruppe">
            <h3 class="mono">{titel}</h3>
            {WERTE.filter((w) => w.gruppe === g).map((w) => (
              <div class="w-zeile" data-k={w.k} data-max={max[w.k]}>
                <span class="w-t">{w.t}</span>
                <span class="w-v mono"><b>{fmtWert(w, erstes.werte[w.k])}</b><em></em></span>
                <span class="w-bar"><i style={`width:${(erstes.werte[w.k] / max[w.k]) * 100}%`}></i><u></u></span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </aside>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="tag data">Übersicht</div><h2>Alle Schiffe im Vergleich</h2></div>
        <p>Grundwerte ab Werft. In der Werkstatt der Bastion lassen sich Kanonen, Rumpf, Schild, Triebwerk, Laser, Frachtraum und Scanner
          in Stufen ausbauen; Module im Inventar geben weitere Prozente. Spaltenkopf antippen zum Sortieren.</p>
      </div>
      <div class="tabelle-scroll">
        <table class="tabelle" id="tabelle">
          <thead>
            <tr>
              <th data-s="n" class="links">Schiff</th>
              <th data-s="len">Länge</th>
              <th data-s="price">Preis</th>
              {WERTE.map((w) => <th data-s={w.k} title={w.e}>{w.t}</th>)}
            </tr>
          </thead>
          <tbody>
            {SCHIFFE.map((s) => (
              <tr data-id={s.id} data-n={s.n} data-len={s.len} data-price={s.price} {...Object.fromEntries(WERTE.map((w) => [`data-${w.k}`, s.werte[w.k]]))}>
                <th class="links" scope="row"><a href={`#${s.id}`}><i style={`background:${s.col}`}></i>{s.n}</a><small>{s.role}</small></th>
                <td class="mono">{lang(s.len)} m</td>
                <td class="mono">{s.price ? s.price.toLocaleString('de-DE') : '–'}</td>
                {WERTE.map((w) => <td class:list={['mono', { best: s.werte[w.k] === max[w.k] && max[w.k] > 0 }]}>{fmtWert(w, s.werte[w.k])}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="hinweis muted">Hervorgehoben: der höchste Wert jeder Spalte. Schaden und Wendigkeit sind Faktoren auf die Grundwerte der Kanonen und der Steuerung.</p>
      <p><a class="btn" href={SPIEL_URL}>Jetzt spielen <span class="pfeil">›</span></a></p>
    </div>
  </section>

  <script type="application/json" id="schiff-daten" set:html={JSON.stringify(daten)}></script>
</Base>

<script>
  import { starteExplorer } from '../scripts/explorer';
  starteExplorer();
</script>

<style>
  .kopfzeile { padding-top: clamp(36px, 6vw, 64px); padding-bottom: 28px; }
  .kopfzeile h1 { font-size: clamp(44px, 7vw, 84px); text-transform: uppercase; margin: 10px 0 12px; }
  .kopfzeile p { max-width: 640px; margin: 0; }

  .explorer { display: grid; grid-template-columns: 210px minmax(0, 1fr) 380px; gap: 16px; align-items: start; padding-bottom: 24px; }
  .wahl { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .w-btn { display: grid; grid-template-columns: 3px 1fr; grid-template-rows: auto auto; column-gap: 12px; text-align: left; padding: 11px 12px; background: none; border: 0;
           border-bottom: 1px solid var(--line); color: var(--mut); cursor: pointer; font: inherit; }
  .w-btn i { grid-row: 1 / 3; width: 3px; opacity: .55; }
  .w-btn b { font: 600 19px/1.1 var(--head); letter-spacing: .07em; text-transform: uppercase; color: var(--txt); }
  .w-btn span { font-size: 13px; }
  .w-btn:hover { background: var(--panel); }
  .w-btn.an { background: var(--panel2); color: var(--txt); box-shadow: inset 2px 0 0 var(--acc); }
  .w-btn.an i { opacity: 1; }

  .buehne { position: sticky; top: 80px; aspect-ratio: 4 / 3.2; max-height: calc(100vh - 100px); overflow: hidden;
            background: radial-gradient(ellipse at 50% 42%, #142231 0%, #0a121b 55%, #05090e 100%); }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  canvas:active { cursor: grabbing; }
  .b-oben { position: absolute; top: 14px; left: 16px; right: 16px; display: flex; justify-content: space-between; gap: 12px; font-size: 13px; color: var(--mut); letter-spacing: .1em; text-transform: uppercase; pointer-events: none; }
  .b-oben #b-name { color: var(--txt); }
  .b-unten { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; flex-wrap: wrap; gap: 8px; }
  .schalter { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; min-height: 36px; background: rgba(4, 7, 11, .7); border: 1px solid var(--line2);
              color: var(--mut); font: 400 12.5px var(--mono); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .schalter:hover { color: var(--txt); }
  .schalter input { accent-color: var(--acc); margin: 0; }
  #opt-reset { margin-left: auto; }
  .lade { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; pointer-events: none; transition: opacity .3s; color: var(--mut); font-size: 13px; letter-spacing: .1em; }
  .lade.weg { opacity: 0; visibility: hidden; transition: opacity .3s, visibility 0s .3s; }
  .balken { width: min(260px, 60%); height: 2px; background: var(--line); }
  .balken i { display: block; height: 100%; width: 0; background: var(--data); transition: width .15s; }
  .kein-3d { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 24px; color: var(--mut); margin: 0; }
  .kein-3d[hidden] { display: none; }

  .info { padding: 20px 22px 22px; }
  .i-kopf { display: flex; justify-content: space-between; gap: 16px; align-items: start; }
  .i-kopf h2 { font-size: 40px; text-transform: uppercase; margin-top: 4px; }
  .i-preis { text-align: right; display: flex; flex-direction: column; gap: 2px; }
  .lbl { font: 400 11px var(--mono); letter-spacing: .16em; text-transform: uppercase; color: var(--dim); }
  .i-preis b { font-weight: 400; color: var(--acc); font-size: 16px; white-space: nowrap; }
  #i-desc { color: var(--mut); font-size: 15px; margin: 12px 0 12px; }
  .i-merk { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; }
  .i-merk :global(span) { padding: 4px 8px; border: 1px solid var(--line); color: var(--mut); }
  .vergleich { display: flex; align-items: center; gap: 12px; margin: 18px 0 6px; padding: 12px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .vergleich label { font: 400 12px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--data); white-space: nowrap; }
  .vergleich select { flex: 1; min-width: 0; min-height: 38px; background: var(--panel2); color: var(--txt); border: 1px solid var(--line2); padding: 6px 10px; font: 400 15px var(--body); border-radius: 0; }
  .w-gruppe { margin-top: 14px; }
  .w-gruppe h3 { font-size: 11.5px; font-weight: 400; letter-spacing: .16em; text-transform: uppercase; color: var(--dim); margin-bottom: 4px; }
  .w-zeile { display: grid; grid-template-columns: 1fr auto; gap: 3px 10px; padding: 6px 0; }
  .w-t { font-size: 14.5px; color: #c9d4de; }
  .w-v { font-size: 14px; text-align: right; white-space: nowrap; }
  .w-v b { font-weight: 400; color: var(--txt); }
  .w-v em { font-style: normal; margin-left: 8px; font-size: 12.5px; }
  .w-v em.plus { color: var(--grn); } .w-v em.minus { color: var(--bad); } .w-v em.gleich { color: var(--dim); }
  .w-bar { grid-column: 1 / -1; position: relative; height: 4px; background: rgba(124, 196, 255, .08); }
  .w-bar i { position: absolute; left: 0; top: 0; bottom: 0; background: var(--acc); transition: width .35s ease; }
  .w-bar u { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--data); left: 0; opacity: 0; transition: left .35s ease, opacity .2s; }
  .vgl-an .w-bar u { opacity: 1; }

  .tabelle-scroll { overflow-x: auto; border: 1px solid var(--line); -webkit-overflow-scrolling: touch; }
  .tabelle { border-collapse: collapse; width: 100%; font-size: 14px; white-space: nowrap; }
  .tabelle th, .tabelle td { padding: 11px 14px; border-bottom: 1px solid var(--line); text-align: right; }
  .tabelle thead th { font: 400 11.5px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--mut); background: var(--panel); cursor: pointer; user-select: none; position: sticky; top: 0; }
  .tabelle thead th:hover { color: var(--txt); }
  .tabelle thead th.sort-auf::after { content: ' ▲'; color: var(--acc); } .tabelle thead th.sort-ab::after { content: ' ▼'; color: var(--acc); }
  .tabelle .links { text-align: left; }
  .tabelle tbody th { position: sticky; left: 0; background: var(--bg); z-index: 1; font-weight: 400; min-width: 170px; }
  .tabelle tbody th a { display: flex; align-items: center; gap: 10px; color: var(--txt); text-decoration: none; font: 600 18px var(--head); letter-spacing: .06em; text-transform: uppercase; }
  .tabelle tbody th a i { width: 3px; height: 18px; }
  .tabelle tbody th small { display: block; color: var(--dim); font-size: 12.5px; padding-left: 13px; }
  .tabelle tbody tr:hover th, .tabelle tbody tr:hover td { background: var(--panel); }
  .tabelle td { color: var(--mut); }
  .tabelle td.best { color: var(--acc); }
  .hinweis { font-size: 14px; margin: 14px 0 28px; }

  @media (max-width: 1180px) {
    .explorer { grid-template-columns: 190px minmax(0, 1fr); }
    .info { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 32px; }
    .info > .i-kopf, .info > #i-desc, .info > .i-merk, .info > .vergleich { grid-column: 1; }
    .info > .werte { grid-column: 2; grid-row: 1 / span 5; }
    .buehne { position: relative; top: 0; }
  }
  @media (max-width: 760px) {
    .explorer { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .wahl { flex-direction: row; overflow-x: auto; border-top: 0; border-bottom: 1px solid var(--line); scrollbar-width: none; margin: 0 calc(-1 * var(--gut)); padding: 0 var(--gut); }
    .wahl::-webkit-scrollbar { display: none; }
    .w-btn { flex: 0 0 auto; border-bottom: 0; padding: 10px 14px 12px; display: block; }
    .w-btn i { display: none; }
    .w-btn span { display: none; }
    .w-btn.an { box-shadow: inset 0 -2px 0 var(--acc); }
    .buehne { aspect-ratio: 1 / 1; max-height: 70vh; margin: 0 calc(-1 * var(--gut)); border-left: 0; border-right: 0; }
    .info { display: block; }
    .i-kopf h2 { font-size: 34px; }
    #opt-reset { margin-left: 0; }
  }
</style>
